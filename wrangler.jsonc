{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "401-w-ontario-github-io",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
